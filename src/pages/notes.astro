---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../utils';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, rendered: await render(note) }))
);
---

<Base title="단상">
  <div class="shell">
    <header class="page-header">
      <p class="page-kicker"><span>02</span> SHORT NOTES</p>
      <h1>단상</h1>
      <p class="muted">
        짧은 생각들. Threads에 올린 글 전체는
        <a href="/threads">쓰레드 아카이브</a>에 모아 둡니다.
      </p>
      <p class="page-count">{String(notes.length).padStart(3, '0')} ENTRIES</p>
    </header>
    {
      renderedNotes.map(({ note, rendered }) => {
        const Content = rendered.Content;
        return (
          <article class="note">
            <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
            <div class="prose">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</Base>
