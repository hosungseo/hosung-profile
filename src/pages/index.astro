---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { NAV_GROUPS, THREADS_URL } from '../consts';
import archive from '../data/threads.json';
import { formatDate } from '../utils';

type Item = { type: string; title: string; url: string; date: Date; desc?: string; external?: boolean };

const writing = (await getCollection('writing', ({ data }) => !data.draft)).map<Item>((p) => ({
  type: '글', title: p.data.title, url: `/writing/${p.id}`, date: p.data.date, desc: p.data.description,
}));
const notes = (await getCollection('notes')).map<Item>((n) => ({
  type: '단상', title: n.body?.split('\n').find((l) => l.trim())?.replace(/^#+\s*/, '').slice(0, 80) ?? '단상', url: '/notes', date: n.data.date,
}));
const press = (await getCollection('press')).map<Item>((p) => ({
  type: '보도자료', title: p.data.title, url: `/press/${p.id}/`, date: p.data.date, desc: p.data.mine,
}));
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const workItems = work.filter((w) => w.data.updated).map<Item>((w) => ({
  type: '작업', title: w.data.title, url: w.data.url ?? '/work', date: w.data.updated!, desc: w.data.description,
}));
const threads = (archive.posts as { text: string; sentAt: string | null; url?: string | null; status: string }[])
  .filter((p) => (p.status === 'sent' || p.status === 'error') && p.sentAt)
  .map<Item>((p) => ({ type: '쓰레드', title: p.text.split('\n')[0].slice(0, 90), url: p.url ?? THREADS_URL, date: new Date(p.sentAt!), external: !!p.url }));

const feed = [...writing, ...notes, ...press, ...workItems, ...threads]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 14);

const counts = [
  { n: writing.length, label: '글' },
  { n: notes.length, label: '단상' },
  { n: threads.length, label: '쓰레드' },
  { n: work.length, label: '작업' },
  { n: press.length, label: '보도자료' },
];

const tools = NAV_GROUPS.find((g) => g.key === 'work')!.items;
const workByUrl = new Map(work.map((w) => [w.data.url?.replace('https://seohosung.com', '').replace(/\/$/, ''), w]));

const questions = ['AI가 바꾸는 일의 단위', '도구가 다시 정의하는 사람', '사람이 여전히 잘하는 것'];
---

<Base>
  <section class="home-top">
    <h1 class="home-wordmark" aria-label="서호성"><span>SEO HOSUNG</span></h1>
    <p class="home-statement">AI가 바꾸는 일과 생각을, 오래 남는 글과 쓸 수 있는 도구로 남깁니다.</p>
    <ul class="home-counts">
      {counts.map((c) => <li><b>{c.n.toLocaleString('ko-KR')}</b>{c.label}</li>)}
      <li><b>{archive.syncedAt ? formatDate(new Date(archive.syncedAt)) : '—'}</b>갱신</li>
    </ul>
  </section>

  <div class="home-grid">
    <section class="home-col" aria-labelledby="home-feed">
      <h2 id="home-feed">최근 활동 <a href="/writing">모든 글 →</a></h2>
      <ol class="feed">
        {
          feed.map((it) => (
            <li>
              <span class="feed-type">{it.type}</span>
              <div>
                <a class="feed-title" href={it.url} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>{it.title}</a>
                {it.desc && <span class="feed-desc">{it.desc}</span>}
              </div>
              <time datetime={it.date.toISOString()}>{formatDate(it.date)}</time>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-col" aria-labelledby="home-tools">
      <h2 id="home-tools">작업물 <a href="/work">전부 →</a></h2>
      <ul class="tools">
        {
          tools.map((t) => {
            const w = workByUrl.get(t.href.replace(/\/$/, ''));
            return (
              <li>
                <a href={t.href} target={t.href.startsWith('http') ? '_blank' : undefined} rel={t.href.startsWith('http') ? 'noopener' : undefined}>
                  {t.label}
                  <span>{w?.data.updated ? formatDate(w.data.updated) : t.href.startsWith('http') ? '↗' : ''}</span>
                </a>
                <p>{t.note ?? w?.data.description ?? ''}</p>
              </li>
            );
          })
        }
      </ul>
      <h2 style="margin-top:2rem">지금 쓰는 질문</h2>
      <ul class="home-questions">
        {questions.map((q) => <li>{q}</li>)}
      </ul>
    </section>
  </div>
</Base>
