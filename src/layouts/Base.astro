---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS, NAV_GROUPS } from '../consts';
import archive from '../data/threads.json';
import '../styles/global.css';
import '../styles/workspace.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description = SITE_DESCRIPTION, type = 'website', publishedTime } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const pageKey = currentPath.split('/').filter(Boolean)[0] || 'home';

// Counts shown next to the sidebar items, so the index reads like a real workspace, not a menu.
const counts: Record<string, number> = {
  '/writing': (await getCollection('writing', ({ data }) => !data.draft)).length,
  '/notes': (await getCollection('notes')).length,
  '/threads': (archive.posts as { status: string }[]).filter((p) => p.status === 'sent' || p.status === 'error').length,
  '/press/': (await getCollection('press')).length,
  '/work': (await getCollection('work')).length,
};

const isCurrent = (href: string) =>
  href.startsWith('http') || href.includes('#') ? false : href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
const section = NAV_GROUPS.flatMap((g) => g.items).find((i) => isCurrent(i.href));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <slot name="head" />
  </head>
  <body data-page={pageKey}>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>
    {
      type === 'article' && (
        <div class="reading-progress" aria-hidden="true" data-reading-progress>
          <span />
        </div>
      )
    }
    <div class="ws">
      <aside class="ws-side" id="ws-side" aria-label="사이트 구조">
        <a href="/" class="ws-brand" aria-label={`${SITE_TITLE} 홈`}>
          <span class="ws-brand-latin">SEO HOSUNG</span>
          <span class="ws-brand-korean">{SITE_TITLE}</span>
        </a>
        <button type="button" class="ws-search-btn" data-search-open aria-haspopup="dialog">
          <span>검색</span>
          <kbd>⌘K</kbd>
        </button>
        <nav class="ws-nav">
          {
            NAV_GROUPS.map((group) => (
              <div class="ws-group">
                <p class="ws-group-label">{group.label}</p>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                        target={item.href.startsWith('http') ? '_blank' : undefined}
                        rel={item.href.startsWith('http') ? 'noopener' : undefined}
                      >
                        <span class="ws-item-label">{item.label}</span>
                        {counts[item.href] !== undefined ? (
                          <span class="ws-item-count">{counts[item.href]}</span>
                        ) : item.href.startsWith('http') ? (
                          <span class="ws-item-count" aria-hidden="true">↗</span>
                        ) : null}
                      </a>
                      {item.note && <span class="ws-item-note">{item.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div class="ws-group ws-group-else">
            <p class="ws-group-label">바깥</p>
            <ul>
              {SOCIAL_LINKS.filter((l) => !l.url.startsWith('mailto')).map((link) => (
                <li><a href={link.url} target="_blank" rel="noopener"><span class="ws-item-label">{link.label}</span><span class="ws-item-count" aria-hidden="true">↗</span></a></li>
              ))}
              <li><a href="/rss.xml"><span class="ws-item-label">RSS</span></a></li>
            </ul>
          </div>
        </nav>
        <p class="ws-side-foot">© {new Date().getFullYear()} {SITE_TITLE} · Sejong</p>
      </aside>
      <div class="ws-main">
        <header class="ws-top">
          <button type="button" class="ws-menu-btn" data-side-toggle aria-controls="ws-side" aria-expanded="false">메뉴</button>
          <a href="/" class="ws-top-brand" aria-label={`${SITE_TITLE} 홈`}>SEO HOSUNG</a>
          <p class="ws-crumb" aria-label="현재 위치">
            <a href="/">홈</a>
            {section && section.href !== '/' && <><span aria-hidden="true">/</span><span>{section.label}</span></>}
            {title && (!section || section.label !== title) && <><span aria-hidden="true">/</span><span class="ws-crumb-title">{title}</span></>}
          </p>
          <button type="button" class="ws-search-btn ws-search-top" data-search-open aria-haspopup="dialog">
            <span>검색</span>
            <kbd>⌘K</kbd>
          </button>
        </header>
        <main id="content" class="ws-content">
          <slot />
        </main>
        <footer class="ws-foot">
          <span>{SITE_TITLE} · AI가 바꾸는 일과 생각을 오래 남는 글로 씁니다.</span>
          <span>{SOCIAL_LINKS.filter((l) => !l.url.startsWith('mailto')).map((l) => <a href={l.url}>{l.label}</a>)}<a href="/rss.xml">RSS</a></span>
        </footer>
      </div>
    </div>
    <div class="ws-scrim" data-side-toggle hidden></div>

    <dialog class="ws-search" id="ws-search" aria-label="사이트 검색">
      <form method="dialog" class="ws-search-form">
        <input type="search" id="ws-search-input" placeholder="글·단상·작업·보도자료·쓰레드 검색" autocomplete="off" aria-label="검색어" />
        <button type="submit" class="ws-search-close" aria-label="닫기">Esc</button>
      </form>
      <ul class="ws-search-results" id="ws-search-results" role="listbox" aria-label="검색 결과"></ul>
      <p class="ws-search-hint">↑↓ 이동 · Enter 열기 · Esc 닫기</p>
    </dialog>

    <script is:inline>
      (() => {
        const progress = document.querySelector('[data-reading-progress] span');
        if (progress) {
          const update = () => {
            const root = document.documentElement;
            const distance = root.scrollHeight - root.clientHeight;
            progress.style.transform = `scaleX(${distance > 0 ? Math.min(root.scrollTop / distance, 1) : 0})`;
          };
          update();
          window.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
        }

        // Phone: the sidebar becomes a drawer.
        const body = document.body;
        const menuBtn = document.querySelector('.ws-menu-btn');
        const setOpen = (open) => {
          body.toggleAttribute('data-side-open', open);
          if (menuBtn) menuBtn.setAttribute('aria-expanded', String(open));
          const scrim = document.querySelector('.ws-scrim');
          if (scrim) scrim.hidden = !open;
        };
        document.querySelectorAll('[data-side-toggle]').forEach((el) =>
          el.addEventListener('click', () => setOpen(!body.hasAttribute('data-side-open')))
        );

        // ⌘K search over a small index built at deploy time.
        const dialog = document.getElementById('ws-search');
        const input = document.getElementById('ws-search-input');
        const list = document.getElementById('ws-search-results');
        if (!dialog || !input || !list) return;
        let index = null;
        let active = -1;
        const TYPE = { writing: '글', notes: '단상', press: '보도자료', work: '작업', threads: '쓰레드', page: '페이지' };
        const load = async () => {
          if (index) return index;
          const res = await fetch('/search.json');
          index = await res.json();
          return index;
        };
        const open = async () => {
          if (dialog.open) return;
          dialog.showModal();
          input.value = '';
          render('');
          input.focus();
          await load();
          render('');
        };
        const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
        const render = (q) => {
          const items = index || [];
          const needle = q.trim().toLowerCase();
          const hits = (needle
            ? items.filter((it) => (it.title + ' ' + (it.text || '')).toLowerCase().includes(needle))
            : items.slice(0, 12)
          ).slice(0, 20);
          active = hits.length ? 0 : -1;
          list.innerHTML = hits.length
            ? hits
                .map(
                  (it, i) =>
                    `<li role="option" aria-selected="${i === active}"><a href="${esc(it.url)}"><span class="ws-r-type">${TYPE[it.type] || it.type}</span><span class="ws-r-title">${esc(it.title)}</span><span class="ws-r-date">${esc(it.date || '')}</span></a></li>`
                )
                .join('')
            : `<li class="ws-r-empty">${needle ? '없습니다.' : '불러오는 중…'}</li>`;
        };
        input.addEventListener('input', () => render(input.value));
        input.addEventListener('keydown', (e) => {
          const opts = list.querySelectorAll('li[role="option"]');
          if (!opts.length) return;
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            active = (active + (e.key === 'ArrowDown' ? 1 : -1) + opts.length) % opts.length;
            opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
            opts[active].scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter' && active >= 0) {
            e.preventDefault();
            const a = opts[active].querySelector('a');
            if (a) window.location.href = a.getAttribute('href');
          }
        });
        document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
        window.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            dialog.open ? dialog.close() : open();
          } else if (e.key === '/' && !dialog.open && !/input|textarea/i.test(document.activeElement?.tagName || '')) {
            e.preventDefault();
            open();
          }
        });
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      })();
    </script>
  </body>
</html>
